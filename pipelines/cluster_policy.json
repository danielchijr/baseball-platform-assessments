{
  "autotermination_minutes": {
    "type": "fixed",
    "value": 15,
    "hidden": false
  },
  "node_type_id": {
    "type": "allowlist",
    "values": [
      "m5.large",
      "m5.xlarge",
      "i3.xlarge"
    ],
    "defaultValue": "m5.large"
  },
  "cluster_type": {
    "type": "fixed",
    "value": "job",
    "hidden": true
  },
  "instance_pool_id": {
    "type": "unlimited",
    "is_required": true
  },
  "spark_version": {
    "type": "regex",
    "pattern": ".*LTS.*",
    "defaultValue": "13.3.x-scala2.12"
  },
  "num_workers": {
    "type": "range",
    "maxValue": 10,
    "defaultValue": 2
  },
  "custom_tags.Team": {
    "type": "fixed",
    "value": "DataEngineering"
  }
}
